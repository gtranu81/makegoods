{
  "name": "jeju-startup-support",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "start": "node --use-env-proxy server.js",
    "dev": "node --use-env-proxy --watch server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check public/app.js"
  }
}
